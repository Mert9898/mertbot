<?xml version="1.0" encoding="UTF-8"?>
<aiml version="2.0">

    <!-- Main greeting category with randomness -->
    <category>
        <pattern>HELLO ^</pattern>
        <template>
            <random>
                <li>Welcome!</li>
                <li>Hello.</li>
                <li>Hello, how are you?</li>
                <li>Hey there.</li>
                <li>Good morning.</li>
            </random>
        </template>
    </category>

    <!-- Reduction: different greetings redirect to HELLO -->
    <category>
        <pattern>HI ^</pattern>
        <template><srai>HELLO <star/></srai></template>
    </category>

    <category>
        <pattern>HOWDY ^</pattern>
        <template><srai>HELLO <star/></srai></template>
    </category>

    <category>
        <pattern>HEY ^</pattern>
        <template><srai>HELLO <star/></srai></template>
    </category>

    <!-- Repeating part of user input -->
    <category>
        <pattern>I AM *</pattern>
        <template>Hello <star/></template>
    </category>

    <category>
        <pattern>WHAT IS *</pattern>
        <template>I have no idea what <star/> is. I'm just a machine.</template>
    </category>

    <!-- Memory: remember the user's name -->
    <category>
        <pattern>MY NAME IS *</pattern>
        <template>Good to know, <set name="name"><star/></set>.</template>
    </category>

    <category>
        <pattern>WHAT'S MY NAME</pattern>
        <template>Your name is <get name="name"/>, right?</template>
    </category>

    <category>
        <pattern>WHAT IS MY NAME</pattern>
        <template><srai>WHAT'S MY NAME</srai></template>
    </category>

    <!-- Optional extra memory: age -->
    <category>
        <pattern>MY AGE IS *</pattern>
        <template>Okay, I will remember that you are <set name="age"><star/></set> years old.</template>
    </category>

    <category>
        <pattern>HOW OLD AM I</pattern>
        <template>You told me that you are <get name="age"/> years old.</template>
    </category>

    <!-- Default fallback response -->
    <category>
        <pattern>*</pattern>
        <template>I don't feel like talking about it. Tell me something about yourself.</template>
    </category>

</aiml>