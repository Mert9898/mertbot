<?xml version="1.0" encoding="UTF-8"?>
<aiml version="2.0">

    <category>
        <pattern>HELLO</pattern>
        <template>
            <random>
                <li>Welcome!</li>
                <li>Hello.</li>
                <li>Hello, how are you?</li>
                <li>Hey there.</li>
                <li>Good morning.</li>
            </random>
        </template>
    </category>

    <category>
        <pattern>HELLO *</pattern>
        <template>Hello <star/></template>
    </category>

    <category>
        <pattern>HI</pattern>
        <template><srai>HELLO</srai></template>
    </category>

    <category>
        <pattern>GOOD MORNING</pattern>
        <template>Good morning! Nice to see you.</template>
    </category>

    <category>
        <pattern>GOOD EVENING</pattern>
        <template>Good evening! How was your day?</template>
    </category>

    <category>
        <pattern>HOWDY</pattern>
        <template><srai>HELLO</srai></template>
    </category>

    <category>
        <pattern>HEY</pattern>
        <template><srai>HELLO</srai></template>
    </category>

    <category>
        <pattern>I AM *</pattern>
        <template>Hello <star/></template>
    </category>

    <category>
        <pattern>I LIKE *</pattern>
        <template>Why do you like <star/>?</template>
    </category>

    <category>
        <pattern>WHAT IS *</pattern>
        <template>I have no idea what <star/> is. I'm just a machine.</template>
    </category>

    <category>
        <pattern>MY NAME IS *</pattern>
        <template>Good to know, <set name="name"><star/></set>!</template>
    </category>

    <category>
        <pattern>WHAT'S MY NAME</pattern>
        <template>Your name is <get name="name"/>, right?</template>
    </category>

    <category>
        <pattern>WHAT IS MY NAME</pattern>
        <template>Your name is <get name="name"/>, right?</template>
    </category>

    <category>
        <pattern>MY AGE IS *</pattern>
        <template>Okay, I will remember that you are <set name="age"><star/></set> years old.</template>
    </category>

    <category>
        <pattern>HOW OLD AM I</pattern>
        <template>You told me that you are <get name="age"/> years old.</template>
    </category>

    <category>
        <pattern>DO YOU LIKE MUSIC</pattern>
        <template>Yes, I like music. It is fun to talk about.</template>
    </category>

    <category>
        <pattern>WHAT IS YOUR FAVORITE FOOD</pattern>
        <template>I think pizza is a very popular food.</template>
    </category>

    <category>
        <pattern>DO YOU LIKE MOVIES</pattern>
        <template>Yes, I like movies. They can be very entertaining.</template>
    </category>

</aiml>